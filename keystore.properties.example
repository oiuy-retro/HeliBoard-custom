# Copy to keystore.properties (same folder) and fill in your own values.
# keystore.properties is gitignored. Never commit it or the keystore.
# If keystore.properties is missing, release builds are signed with the Android debug key.
storeFile=/absolute/path/to/heliboard-custom-release.jks
storePassword=your-store-password
keyAlias=heliboard-custom
keyPassword=your-key-password
